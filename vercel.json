{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build",
  "framework": "vite",
  "installCommand": "corepack pnpm install --frozen-lockfile",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/setup",
      "destination": "/guide/",
      "permanent": true
    },
    {
      "source": "/setup/",
      "destination": "/guide/",
      "permanent": true
    }
  ]
}
