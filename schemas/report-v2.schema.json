                    "description": "The screenshot after the change."
                  }
                },
                "required": [
                  "candidate"
                ],
                "additionalProperties": false,
                "description": "The images available for this screenshot."
              },
              "status": {
                "type": "string",
                "const": "added",
                "description": "The screenshot exists only after the change."
              }
            },
            "required": [
              "file",
              "image",
              "images",
              "status"
            ],
            "additionalProperties": false
          },
