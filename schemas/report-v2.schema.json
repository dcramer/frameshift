                "allOf": [
                  {
                    "pattern": "^(?!\\/)(?!.*\\\\)(?!.*(?:^|\\/)\\.\\.(?:\\/|$)).+\\.png$"
                  },
                  {
                    "pattern": "^images\\/candidate\\/.*"
                  }
