      "properties": {
        "added": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Number of added screenshots."
        },
        "changed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Number of changed screenshots."
        },
        "removed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Number of removed screenshots."
        },
        "unchanged": {
